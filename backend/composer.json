{
    "name": "tuitionpro/erp-backend",
    "description": "TuitionPro ERP — Multi-Tenant Tuition Institute Backend Engine",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^2.1",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
