# TuitionPro ERP - Environment Configuration Template
# Copy this file to .env and configure your environment settings.

APP_NAME="TuitionPro ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET_KEY=generate-a-secure-random-32-char-string-here
APP_TIMEZONE=Asia/Colombo

# Single-Institute Installation Profile
INSTITUTE_NAME="Apex Higher Education Institute"
INSTITUTE_CODE=apex
INSTITUTE_EMAIL=info@apexeducation.lk
INSTITUTE_PHONE="+94 11 234 5678"
INSTITUTE_ADDRESS="No. 123, Galle Road, Colombo 03, Sri Lanka"
INSTITUTE_TIMEZONE=Asia/Colombo
INSTITUTE_CURRENCY=LKR
INSTITUTE_CURRENCY_SYMBOL="Rs. "

# JWT Authentication Security (HS256)
JWT_SECRET=generate-a-secure-random-64-char-signing-key-here
JWT_ISSUER=tuitionpro-erp
JWT_AUDIENCE=tuitionpro-users
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Database Connection (MySQL 8.0+ InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuitionpro
DB_USERNAME=root
DB_PASSWORD=

# Session Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Logging
LOG_LEVEL=debug
LOG_MAX_FILES=30

# File Uploads & Backups
UPLOAD_MAX_SIZE_MB=10
BACKUP_RETENTION_DAYS=30

# Mail Configuration (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tuitionpro.lk
MAIL_FROM_NAME="TuitionPro ERP"
MAIL_ENCRYPTION=tls

# SMS Gateway Configuration
SMS_DRIVER=none
SMS_API_KEY=
SMS_SENDER_ID=TuitionPro

# System Administrator Support
PLATFORM_NAME="TuitionPro System Administration"
PLATFORM_SUPPORT_EMAIL=support@tuitionpro.lk